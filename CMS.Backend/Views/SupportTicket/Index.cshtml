@model CMS.Backend.Models.SupportTicketAdminListPageViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
    <div>
        <h2 class="fw-bold mb-1">Hỗ trợ khách hàng</h2>
        <p class="text-muted mb-0">Theo dõi ticket, kiểm tra trao đổi và xử lý các yêu cầu hỗ trợ từ website.</p>
    </div>
    <button type="button" class="btn btn-outline-primary rounded-3 px-4 py-2">
        <i class="bi bi-download me-2"></i>Xuất Excel
    </button>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small mb-2">Tất cả</div><div class="display-6 fw-bold text-dark">@Model.Stats.TotalCount</div></div></div>
    </div>
    <div class="col-xl col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small mb-2">Chưa đọc</div><div class="display-6 fw-bold text-danger">@Model.Stats.UnreadCount</div></div></div>
    </div>
    <div class="col-xl col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small mb-2">Đang xử lý</div><div class="display-6 fw-bold text-warning">@Model.Stats.InProgressCount</div></div></div>
    </div>
    <div class="col-xl col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small mb-2">Chờ phản hồi</div><div class="display-6 fw-bold text-primary">@Model.Stats.WaitingCount</div></div></div>
    </div>
    <div class="col-xl col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small mb-2">Đã giải quyết</div><div class="display-6 fw-bold text-success">@Model.Stats.ResolvedCount</div></div></div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-4">
                <label class="form-label">Tìm kiếm</label>
                <input class="form-control rounded-3" name="keyword" value="@Model.Filter.Keyword" placeholder="Tìm theo mã, khách hàng, email, tiêu đề..." />
            </div>
            <div class="col-lg-2">
                <label class="form-label">Trạng thái</label>
                <select class="form-select rounded-3" name="status">
                    <option value="">Tất cả trạng thái</option>
                    <option value="new" selected="@(Model.Filter.Status == "new")">Mới tiếp nhận</option>
                    <option value="in-progress" selected="@(Model.Filter.Status == "in-progress")">Đang xử lý</option>
                    <option value="waiting-customer" selected="@(Model.Filter.Status == "waiting-customer")">Chờ phản hồi</option>
                    <option value="resolved" selected="@(Model.Filter.Status == "resolved")">Đã giải quyết</option>
                </select>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Danh mục</label>
                <select class="form-select rounded-3" name="category">
                    <option value="">Tất cả danh mục</option>
                    <option value="order" selected="@(Model.Filter.Category == "order")">Đơn hàng</option>
                    <option value="product" selected="@(Model.Filter.Category == "product")">Sản phẩm</option>
                    <option value="payment" selected="@(Model.Filter.Category == "payment")">Thanh toán</option>
                    <option value="promotion" selected="@(Model.Filter.Category == "promotion")">Khuyến mãi</option>
                </select>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Ưu tiên</label>
                <select class="form-select rounded-3" name="priority">
                    <option value="">Tất cả mức độ</option>
                    <option value="low" selected="@(Model.Filter.Priority == "low")">Thấp</option>
                    <option value="normal" selected="@(Model.Filter.Priority == "normal")">Bình thường</option>
                    <option value="high" selected="@(Model.Filter.Priority == "high")">Cao</option>
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button class="btn btn-primary rounded-3 w-100" type="submit">Lọc</button>
                <a class="btn btn-outline-secondary rounded-3 w-100" asp-action="Index">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0 support-admin-table">
            <thead class="bg-light">
                <tr>
                    <th>Mã yêu cầu</th>
                    <th>Khách hàng</th>
                    <th>Tiêu đề</th>
                    <th>Danh mục</th>
                    <th>Trạng thái</th>
                    <th>Ưu tiên</th>
                    <th>Chưa đọc</th>
                    <th>Cập nhật cuối</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-5">Chưa có ticket phù hợp với bộ lọc hiện tại.</td></tr>
                }
                @foreach (var ticket in Model.Items)
                {
                    <tr>
                        <td><a class="fw-bold text-decoration-none" asp-action="Details" asp-route-id="@ticket.Id">@ticket.Code</a></td>
                        <td><div class="fw-semibold">@ticket.CustomerName</div><div class="text-muted small">@ticket.CustomerEmail</div></td>
                        <td><div class="fw-semibold">@ticket.Subject</div>@if (!string.IsNullOrWhiteSpace(ticket.RelatedOrderCode)) { <div class="text-muted small">@ticket.RelatedOrderCode</div> }</td>
                        <td><span class="badge rounded-pill text-bg-light border px-3 py-2">@ticket.CategoryLabel</span></td>
                        <td><span class="support-admin-pill tone-@ticket.StatusTone">@ticket.StatusLabel</span></td>
                        <td><span class="support-admin-priority tone-@ticket.PriorityTone">@ticket.PriorityLabel</span></td>
                        <td>@if (ticket.UnreadCount > 0) { <span class="support-admin-unread">@ticket.UnreadCount</span> } else { <span class="text-muted">0</span> }</td>
                        <td>@ticket.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><a class="btn btn-sm btn-outline-primary rounded-3" asp-action="Details" asp-route-id="@ticket.Id"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 p-3">
        <div class="text-muted">Hiển thị @Model.Items.Count dòng trong tổng số @Model.TotalItems ticket</div>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
                {
                    <li class="page-item @(pageIndex == Model.Filter.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@pageIndex" asp-route-pageSize="@Model.Filter.PageSize" asp-route-keyword="@Model.Filter.Keyword" asp-route-status="@Model.Filter.Status" asp-route-category="@Model.Filter.Category" asp-route-priority="@Model.Filter.Priority">@pageIndex</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

<style>
    .support-admin-table th, .support-admin-table td { padding: 1rem 1.1rem; vertical-align: middle; }
    .support-admin-pill, .support-admin-priority, .support-admin-unread { display: inline-flex; align-items: center; justify-content: center; min-height: 32px; padding: 0 .95rem; border-radius: 999px; font-size: .82rem; font-weight: 700; }
    .support-admin-pill.tone-new { color: #d97706; background: #fff4e5; }
    .support-admin-pill.tone-progress { color: #dc2626; background: #fff1f2; }
    .support-admin-pill.tone-waiting { color: #f97316; background: #fff7ed; }
    .support-admin-pill.tone-resolved { color: #16a34a; background: #eafbf0; }
    .support-admin-priority.tone-high { color: #dc2626; }
    .support-admin-priority.tone-normal { color: #d97706; }
    .support-admin-priority.tone-low { color: #64748b; }
    .support-admin-unread { min-width: 2rem; background: #dc2626; color: #fff; }
</style>
