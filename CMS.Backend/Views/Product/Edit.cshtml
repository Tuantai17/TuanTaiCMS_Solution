@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Edit Product</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-pencil-square"></i> Chỉnh sửa sản phẩm</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form id="product-edit-form" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm: <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm:</label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="mb-3">
                        <label asp-for="CategoryProductId" class="form-label fw-bold">Loại sản phẩm: <span class="text-danger">*</span></label>
                        <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProductList" required>
                            <option value="">-- Chọn loại sản phẩm --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán (₫): <span class="text-danger">*</span></label>
                        <input asp-for="Price" class="form-control" type="number" min="0" step="1000" required />
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch mb-1">
                            <input asp-for="IsSale" class="form-check-input" type="checkbox" id="IsSaleCheckbox" style="cursor: pointer; width: 2.2em; height: 1.1em;" />
                            <label class="form-check-label fw-bold ms-1" for="IsSaleCheckbox">Sản phẩm khuyến mãi (SALE)</label>
                        </div>
                        <div class="input-group input-group-sm mb-1" style="width: 150px;">
                            <span class="input-group-text">Thứ tự</span>
                            <input asp-for="DisplayOrderSale" class="form-control" type="number" min="0" placeholder="0" />
                        </div>
                    </div>

                    <div class="mb-3" id="SalePriceWrapper" style="display: none;">
                        <label asp-for="SalePrice" class="form-label fw-bold text-danger">Giá khuyến mãi (₫):</label>
                        <input asp-for="SalePrice" class="form-control border-danger" type="number" min="0" step="1000" />
                        <span asp-validation-for="SalePrice" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng tồn kho:</label>
                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                    </div>

                    <div class="mb-3 d-flex gap-4 border p-2 rounded bg-light">
                        <div>
                            <div class="form-check mb-1">
                                <input asp-for="IsNew" class="form-check-input" type="checkbox" id="IsNewCheckbox" style="cursor: pointer;" />
                                <label class="form-check-label fw-bold text-success" for="IsNewCheckbox" style="cursor: pointer;">MỚI (NEW)</label>
                            </div>
                            <div class="input-group input-group-sm" style="width: 140px;">
                                <span class="input-group-text">Thứ tự</span>
                                <input asp-for="DisplayOrderNew" class="form-control" type="number" min="0" placeholder="0" />
                            </div>
                        </div>

                        <div>
                            <div class="form-check mb-1">
                                <input asp-for="IsBestSelling" class="form-check-input" type="checkbox" id="IsBestSellingCheckbox" style="cursor: pointer;" />
                                <label class="form-check-label fw-bold text-warning" for="IsBestSellingCheckbox" style="cursor: pointer;">BÁN CHẠY (BEST)</label>
                            </div>
                            <div class="input-group input-group-sm" style="width: 140px;">
                                <span class="input-group-text">Thứ tự</span>
                                <input asp-for="DisplayOrderBestSelling" class="form-control" type="number" min="0" placeholder="0" />
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh đại diện hiện tại:</label>
                            <img src="@Model.ImageUrl" class="img-fluid rounded-4 border d-block mx-auto" style="max-height: 150px; object-fit: contain;" alt="Ảnh sản phẩm @Model.Name" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Thay ảnh đại diện mới:</label>
                        <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Để trống nếu muốn giữ ảnh đại diện cũ.</small>
                    </div>

                    @if (Model.ProductImages != null && Model.ProductImages.Any())
                    {
                        <div class="mb-3 border p-2 rounded">
                            <label class="form-label fw-bold text-danger d-block mb-2"><i class="bi bi-trash"></i> Ảnh chi tiết hiện tại (Tích chọn để XÓA):</label>
                            <div class="row g-2">
                                @foreach (var img in Model.ProductImages)
                                {
                                    <div class="col-4 position-relative text-center">
                                        <img src="@img.ImageUrl" class="img-thumbnail rounded" style="height: 70px; width: 70px; object-fit: cover;" />
                                        <div class="position-absolute" style="top: -5px; right: 5px;">
                                            <input type="checkbox" name="deleteGalleryImages" value="@img.Id" class="form-check-input border-danger" style="cursor: pointer; width: 1.2em; height: 1.2em; background-color: #fff;" title="Tích chọn để xóa ảnh này" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tải thêm ảnh chi tiết khác:</label>
                        <input type="file" name="galleryImages" class="form-control" accept="image/*" multiple />
                        <small class="text-muted">Chọn thêm các góc chụp mới cho sản phẩm.</small>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-warning" id="product-update-button">
                            <i class="bi bi-check-circle"></i> Cập nhật sản phẩm
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Xử lý xác nhận submit form
    document.getElementById('product-edit-form').addEventListener('submit', function (e) {
      if (!confirm('Bạn có chắc muốn cập nhật sản phẩm này không?')) {
        e.preventDefault();
      }
    });

    // Ẩn/hiện trường nhập giá Sale
    const isSaleCheckbox = document.getElementById("IsSaleCheckbox");
    const salePriceWrapper = document.getElementById("SalePriceWrapper");
    const salePriceInput = document.querySelector("#SalePriceWrapper input");

    function toggleSalePrice() {
      if (isSaleCheckbox.checked) {
        salePriceWrapper.style.display = "block";
      } else {
        salePriceWrapper.style.display = "none";
        // Giữ lại 0 hoặc rỗng khi tắt
      }
    }

    isSaleCheckbox.addEventListener("change", toggleSalePrice);
    toggleSalePrice(); // Chạy lúc khởi tạo
  });
</script>
}
