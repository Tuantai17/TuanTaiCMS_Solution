@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Product Details</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-eye"></i> Chi tiết sản phẩm</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="admin-card__body">
        <div class="row g-4">
            <div class="col-lg-4">
                <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "https://placehold.co/480x360/e9ecef/6c757d?text=No+Image" : Model.ImageUrl)"
                     class="img-fluid rounded-3 border mb-3 d-block mx-auto"
                     style="max-height: 300px; object-fit: contain;"
                     alt="Ảnh sản phẩm @Model.Name"
                     referrerpolicy="no-referrer"
                     onerror="this.onerror=null;this.src='https://placehold.co/480x360/e9ecef/6c757d?text=No+Image';" />

                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <div class="border p-3 rounded bg-light">
                        <p class="small fw-bold mb-2 text-muted"><i class="bi bi-images"></i> Album ảnh chi tiết (@Model.ProductImages.Count):</p>
                        <div class="row g-2">
                            @foreach (var img in Model.ProductImages)
                            {
                                <div class="col-3">
                                    <a href="@img.ImageUrl" target="_blank" title="Xem ảnh lớn">
                                        <img src="@img.ImageUrl" class="img-thumbnail rounded" style="height: 55px; width: 55px; object-fit: cover; cursor: zoom-in;" />
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="col-lg-8">
                <table class="table table-bordered align-middle">
                    <tr>
                        <th style="width: 180px;" class="bg-light">Mã sản phẩm</th>
                        <td>#@Model.Id</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Tên sản phẩm</th>
                        <td><strong>@Model.Name</strong></td>
                    </tr>
                    <tr>
                        <th class="bg-light">Loại sản phẩm</th>
                        <td><span class="post-category-badge">@(Model.CategoryProduct?.Name ?? "Chưa phân loại")</span></td>
                    </tr>
                    <tr>
                        <th class="bg-light">Giá niêm yết (Gốc)</th>
                        <td>
                            @if (Model.IsSale)
                            {
                                <span class="text-decoration-line-through text-muted">@Model.Price.ToString("N0") ₫</span>
                            }
                            else
                            {
                                <strong class="text-success fs-5">@Model.Price.ToString("N0") ₫</strong>
                            }
                        </td>
                    </tr>
                    @if (Model.IsSale)
                    {
                        <tr>
                            <th class="bg-light text-danger">Giá khuyến mãi (SALE)</th>
                            <td>
                                <strong class="text-danger fs-5">@Model.SalePrice.ToString("N0") ₫</strong>
                                <span class="badge bg-danger ms-2">SALE -@((int)Math.Round((1 - Model.SalePrice / Model.Price) * 100))%</span>
                            </td>
                        </tr>
                    }
                    <tr>
                        <th class="bg-light">Nổi bật trang chủ</th>
                        <td>
                            @if (Model.IsNew)
                            {
                                <span class="badge bg-success me-1 px-2.5 py-1.5 fs-7">NEW</span>
                            }
                            @if (Model.IsBestSelling)
                            {
                                <span class="badge bg-warning text-dark me-1 px-2.5 py-1.5 fs-7">BEST SELLER</span>
                            }
                            @if (!Model.IsNew && !Model.IsBestSelling)
                            {
                                <span class="text-muted small">Không ghim nổi bật</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th class="bg-light">Tồn kho</th>
                        <td>
                            @if (Model.StockQuantity > 0)
                            {
                                <span class="badge bg-success fs-6">@Model.StockQuantity sản phẩm</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Hết hàng</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th class="bg-light">Mô tả</th>
                        <td style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả" : Model.Description)</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</section>
