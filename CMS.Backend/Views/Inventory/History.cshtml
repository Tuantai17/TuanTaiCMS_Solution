@model IEnumerable<CMS.Data.Entities.InventoryTransaction>
@{
    ViewData["Title"] = "Lịch sử kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    int totalItems = ViewBag.TotalItems ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 15;
    int totalPages = ViewBag.TotalPages ?? 1;
    int startItem = totalItems == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    int endItem = Math.Min(currentPage * pageSize, totalItems);
}

<style>
    .admin-page-title {
        display: none !important; /* Xóa H1 thừa từ Layout */
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1 fw-bold">LỊCH SỬ KHO</h2>
        <p class="text-muted mb-0 small">Xem lịch sử nhập xuất và biến động tồn kho.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã GD</th>
                        <th>Thời gian</th>
                        <th>Sản phẩm / SKU</th>
                        <th>Loại GD</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-center">Tồn trước</th>
                        <th class="text-center">Tồn sau</th>
                        <th>Lý do / Tham chiếu</th>
                        <th>Người thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4">Chưa có lịch sử giao dịch nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        string changeClass = item.QuantityChange > 0 ? "text-success fw-bold" : (item.QuantityChange < 0 ? "text-danger fw-bold" : "");
                        string changePrefix = item.QuantityChange > 0 ? "+" : "";

                        <tr>
                            <td><small class="text-muted">#@item.Id</small></td>
                            <td>
                                <small class="d-block">@item.CreatedAt.ToString("dd/MM/yyyy")</small>
                                <small class="text-muted">@item.CreatedAt.ToString("HH:mm:ss")</small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(string.IsNullOrEmpty(item.Inventory?.Product?.ImageUrl) ? "/images/placeholder.jpg" : item.Inventory?.Product?.ImageUrl)" alt="" style="width: 40px; height: 40px; object-fit: contain; border-radius: 4px; border: 1px solid #ddd; background: white;" />
                                    <div>
                                        <div class="fw-bold text-truncate" style="max-width: 250px;" title="@item.Inventory?.Product?.Name">@item.Inventory?.Product?.Name</div>
                                        <div class="small text-muted">
                                            SKU: SP-@(item.Inventory?.ProductId.ToString("D4")) 
                                            <span class="mx-1">|</span> 
                                            @(item.Inventory?.Product?.CategoryProduct?.Name ?? "Chưa phân loại")
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-secondary">@item.TransactionType</span></td>
                            <td class="text-center @changeClass">@changePrefix@item.QuantityChange</td>
                            <td class="text-center text-muted">@item.StockBefore</td>
                            <td class="text-center fw-bold">@item.StockAfter</td>
                            <td>
                                <div class="small">@item.Reason</div>
                                @if(item.ReferenceId.HasValue)
                                {
                                    <small class="text-muted d-block">Ref: @item.ReferenceType #@item.ReferenceId</small>
                                }
                            </td>
                            <td><small>@item.CreatedBy</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">
            <div class="small text-muted">
                Hiển thị <strong>@startItem–@endItem</strong> trên tổng <strong>@totalItems</strong> giao dịch
            </div>
            @if (totalPages > 1)
            {
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("History", new { page = currentPage - 1, pageSize })">Trước</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("History", new { page = i, pageSize })">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("History", new { page = currentPage + 1, pageSize })">Sau</a>
                    </li>
                </ul>
            }
        </div>
    </div>
</div>
