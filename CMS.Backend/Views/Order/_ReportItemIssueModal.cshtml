@model CMS.Backend.Models.ReportOrderItemIssueViewModel

<style>
    .issue-modal-header {
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 15px;
        margin-bottom: 15px;
    }
    .issue-modal-title {
        text-transform: uppercase;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
        font-size: 1.1rem;
    }
    .product-info-box {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }
    .product-info-img {
        width: 70px;
        height: 70px;
        object-fit: contain;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        margin-right: 15px;
    }
    .product-info-name {
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .product-info-sku {
        font-size: 0.85rem;
        color: #6b7280;
    }
    .stat-boxes {
        display: flex;
        gap: 10px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }
    .stat-box {
        flex: 1;
        min-width: 120px;
        padding: 12px;
        border-radius: 6px;
        text-align: center;
        border: 1px solid rgba(0,0,0,0.05);
    }
    .stat-box-title {
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-bottom: 5px;
    }
    .stat-box-value {
        font-size: 1.25rem;
        font-weight: 700;
    }
    .stat-ordered { background-color: #eff6ff; color: #1d4ed8; }
    .stat-reserved { background-color: #ecfdf5; color: #047857; }
    .stat-physical { background-color: #fff7ed; color: #c2410c; }
    .stat-fulfillable { background-color: #fef2f2; color: #b91c1c; }
    
    .form-group-label {
        font-weight: 600;
        color: #374151;
        font-size: 0.9rem;
        margin-bottom: 6px;
    }
    .required-star {
        color: #dc2626;
    }
    .custom-input {
        border-radius: 6px;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }
    .custom-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }
</style>

<div class="modal fade" id="reportItemIssueModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" style="max-width: 760px;">
        <div class="modal-content" style="border-radius: 8px; border: none; box-shadow: 0 12px 35px rgba(0, 0, 0, 0.22);">
            <div class="modal-body p-4">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center issue-modal-header">
                    <h5 class="issue-modal-title">BÁO THIẾU / HÀNG HƯ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <!-- Product Info -->
                <div class="product-info-box">
                    @if (!string.IsNullOrWhiteSpace(Model.ProductImageUrl))
                    {
                        <img src="@Model.ProductImageUrl" class="product-info-img" alt="@Model.ProductName" />
                    }
                    else
                    {
                        <div class="product-info-img d-flex align-items-center justify-content-center bg-light">
                            <i class="bi bi-box fs-3 text-muted"></i>
                        </div>
                    }
                    <div>
                        <div class="product-info-name">@Model.ProductName</div>
                        <div class="product-info-sku">SKU: @Model.SKU</div>
                    </div>
                </div>

                <!-- Statistics -->
                <div class="stat-boxes">
                    <div class="stat-box stat-ordered">
                        <div class="stat-box-title"><i class="bi bi-info-circle"></i> Số lượng đặt</div>
                        <div class="stat-box-value" id="statOrderedQty">@Model.OrderedQuantity</div>
                    </div>
                    <div class="stat-box stat-reserved">
                        <div class="stat-box-title"><i class="bi bi-box-seam"></i> Đang giữ kho</div>
                        <div class="stat-box-value">@Model.ReservedQuantity</div>
                    </div>
                </div>

                <form id="frmReportIssue" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OrderId" />
                    <input type="hidden" asp-for="OrderDetailId" />
                    <input type="hidden" id="hdnOrderedQuantity" value="@Model.OrderedQuantity" />
                    <input type="hidden" asp-for="FulfillableQuantity" id="hdnFulfillableQuantity" value="@Model.FulfillableQuantity" />

                    <div class="mb-3">
                        <label class="form-group-label" asp-for="IssueType">Loại sự cố <span class="required-star">*</span></label>
                        <select asp-for="IssueType" class="form-select custom-input" id="ddlIssueType" required>
                            <option value="">-- Chọn loại sự cố --</option>
                            <option value="1">Hàng bị hư</option>
                            <option value="0">Thiếu hàng</option>
                            <option value="2">Thất lạc</option>
                            <option value="3">Không đạt chất lượng</option>
                            <option value="4">Khác</option>
                        </select>
                        <div class="invalid-feedback">Vui lòng chọn loại sự cố.</div>
                    </div>

                    <!-- Quantities -->
                    <div class="row mb-3 g-3">
                        <div class="col-md-4">
                            <label class="form-group-label" asp-for="FulfillableQuantity">Số lượng có thể giao <span class="required-star">*</span></label>
                            <input type="number" class="form-control custom-input qty-input" id="txtFulfillableQty" min="0" step="1" value="@Model.FulfillableQuantity" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-group-label" asp-for="DamagedQuantity">Số lượng bị hư <span class="required-star">*</span></label>
                            <input type="number" asp-for="DamagedQuantity" class="form-control custom-input qty-input" id="txtDamagedQty" min="0" step="1" value="0" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-group-label" asp-for="MissingQuantity">Số lượng bị thiếu</label>
                            <input type="number" asp-for="MissingQuantity" class="form-control custom-input qty-input" id="txtMissingQty" min="0" step="1" value="0" />
                        </div>
                    </div>
                    <div class="text-danger small mb-3" id="qtyErrorMsg" style="display:none;">Tổng số lượng không được vượt quá số lượng đặt. Ít nhất hàng thiếu hoặc hàng hư phải lớn hơn 0.</div>

                    <!-- Reason -->
                    <div class="mb-3">
                        <label class="form-group-label" asp-for="Reason">Lý do <span class="required-star">*</span></label>
                        <textarea asp-for="Reason" class="form-control custom-input" id="txtReason" rows="3" placeholder="Mô tả tình trạng sản phẩm và lý do không thể giao đủ cho khách hàng..." required minlength="10" maxlength="1000"></textarea>
                        <div class="invalid-feedback">Vui lòng nhập lý do (ít nhất 10 ký tự).</div>
                    </div>

                    <!-- Internal Note -->
                    <div class="mb-4">
                        <label class="form-group-label" asp-for="InternalNote">Ghi chú nội bộ</label>
                        <textarea asp-for="InternalNote" class="form-control custom-input" rows="2" placeholder="Thông tin dành cho nhân viên nội bộ, không hiển thị cho khách hàng..." maxlength="2000"></textarea>
                    </div>

                    <!-- Footer -->
                    <div class="d-flex justify-content-end border-top pt-3 mt-2">
                        <button type="button" class="btn btn-light border me-2 text-secondary fw-semibold" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-danger fw-semibold" id="btnSubmitReportIssue">
                            <i class="bi bi-check-circle me-1"></i> Xác nhận sự cố
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
