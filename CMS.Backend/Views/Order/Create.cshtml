@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Thêm đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Create Order</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-cart-plus"></i> Thêm đơn hàng mới</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form id="order-create-form" asp-action="Create" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="CustomerId" class="form-label fw-bold">Khách hàng: <span class="text-danger">*</span></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerList" required>
                            <option value="">-- Chọn khách hàng --</option>
                        </select>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrderDate" class="form-label fw-bold">Ngày đặt:</label>
                                <input asp-for="OrderDate" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label fw-bold">Trạng thái:</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="0">Chờ duyệt</option>
                                    <option value="1">Đang giao</option>
                                    <option value="2">Đã xong</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-bold">Ghi chú:</label>
                        <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Ghi chú cho đơn hàng..."></textarea>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success" id="order-save-button"><i class="bi bi-check-circle"></i> Lưu đơn hàng</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
  document.getElementById('order-create-form').addEventListener('submit', function (e) {
    if (!confirm('Bạn có chắc muốn tạo đơn hàng này không?')) e.preventDefault();
  });
</script>
}
