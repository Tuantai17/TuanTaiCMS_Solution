@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var badgeClass = Model.Status switch { 0 => "bg-warning text-dark", 1 => "bg-primary", 2 => "bg-success", _ => "bg-secondary" };
    var statusText = Model.Status switch { 0 => "Chờ duyệt", 1 => "Đang giao", 2 => "Đã xong", _ => "Không xác định" };
    var total = Model.OrderDetails?.Sum(x => x.Quantity * x.UnitPrice) ?? 0;
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Order Details</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-receipt"></i> Chi tiết đơn hàng #@Model.Id</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="OrderDetail" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm dòng hàng</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </div>
    </div>

    <div class="admin-card__body">
        <div class="row g-4 mb-4">
            <div class="col-lg-5">
                <table class="table table-bordered">
                    <tr><th class="bg-light" style="width:150px;">Khách hàng</th><td>@(Model.Customer?.FullName ?? "-")</td></tr>
                    <tr><th class="bg-light">Email</th><td>@(Model.Customer?.Email ?? "-")</td></tr>
                    <tr><th class="bg-light">Ngày đặt</th><td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
                    <tr><th class="bg-light">Trạng thái</th><td><span class="badge @badgeClass">@statusText</span></td></tr>
                    <tr><th class="bg-light">Ghi chú</th><td>@(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có" : Model.Notes)</td></tr>
                </table>
            </div>
            <div class="col-lg-7">
                <div class="p-4 bg-light border rounded-3 h-100 d-flex flex-column justify-content-center">
                    <span class="text-muted small">Tổng giá trị đơn hàng</span>
                    <strong class="display-6 text-success">@total.ToString("N0") ₫</strong>
                    <span class="text-muted">Tổng cộng @(Model.OrderDetails?.Count ?? 0) dòng hàng</span>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td><strong>@(detail.Product?.Name ?? "Sản phẩm đã xóa")</strong></td>
                                <td>@detail.Quantity</td>
                                <td>@detail.UnitPrice.ToString("N0") ₫</td>
                                <td><strong>@((detail.Quantity * detail.UnitPrice).ToString("N0")) ₫</strong></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center py-4 text-muted">Đơn hàng chưa có chi tiết sản phẩm.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
