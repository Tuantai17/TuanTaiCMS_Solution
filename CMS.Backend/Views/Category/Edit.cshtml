Mô tả: Form chỉnh sửa danh mục trong khu vực quản trị.

Chú thích chi tiết:
- View này hiển thị form chỉnh sửa thông tin danh mục.
- Input hidden Id giúp controller biết chính xác danh mục cần cập nhật.
- Các trường Name và Description được bind trực tiếp với model Category.
*@

@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Edit Category</p>
            <h2 class="h4 fw-bold mb-0">Chỉnh sửa danh mục</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">Tên danh mục:</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold">Mô tả:</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning" id="category-update-button">
                    <i class="bi bi-pencil-square"></i> Cập nhật thay đổi
                </button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>
        </form>
    </div>
</section>
