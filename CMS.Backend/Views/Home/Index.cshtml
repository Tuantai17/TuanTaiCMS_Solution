Mô tả: Trang Dashboard quản trị bán hàng thương mại điện tử hiện đại.
        Hiển thị dữ liệu thật từ database: thống kê tổng quan, biểu đồ doanh thu,
        top sản phẩm bán chạy và đơn hàng mới nhất.
*@

@model CMS.Backend.Models.DashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển";
}

@* ===== ROW 1: 4 STAT CARDS ===== *@
<section class="db-stat-row" aria-label="Thống kê tổng quan">
    <div class="db-stat-card db-stat--revenue">
        <div class="db-stat-card__icon">
            <i class="bi bi-wallet2"></i>
        </div>
        <div class="db-stat-card__body">
            <span class="db-stat-card__label" style="display:flex; justify-content:space-between; align-items:center;">
                Tổng doanh thu
                <form method="get" id="revenueFilterForm" class="db-revenue-filter" style="display:inline-block; margin-left:10px;">
                    <select name="revenueFilter" class="form-select form-select-sm" style="width: auto; display: inline-block; background-color: rgba(255,255,255,0.1); color: inherit; border: 1px solid rgba(255,255,255,0.2);" onchange="toggleCustomDates(this.value); if(this.value !== 'custom') this.form.submit();">
                        <option style="color: black;" value="all" selected="@(Model.RevenueFilter == "all")">Tất cả</option>
                        <option style="color: black;" value="24h" selected="@(Model.RevenueFilter == "24h")">24 giờ qua</option>
                        <option style="color: black;" value="7days" selected="@(Model.RevenueFilter == "7days")">7 ngày qua</option>
                        <option style="color: black;" value="30days" selected="@(Model.RevenueFilter == "30days")">30 ngày qua</option>
                        <option style="color: black;" value="custom" selected="@(Model.RevenueFilter == "custom")">Tùy chỉnh...</option>
                    </select>
                </form>
            </span>
            <div id="customDateRange" style="display: @(Model.RevenueFilter == "custom" ? "block" : "none"); margin-top: 10px; font-size: 0.85rem;">
                <form method="get" id="customRevenueForm" style="display:flex; gap:5px; flex-wrap:wrap; align-items:center;">
                    <input type="hidden" name="revenueFilter" value="custom" />
                    <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width:auto; background-color: rgba(255,255,255,0.1); color: inherit; border: 1px solid rgba(255,255,255,0.2);" required />
                    <span>-</span>
                    <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width:auto; background-color: rgba(255,255,255,0.1); color: inherit; border: 1px solid rgba(255,255,255,0.2);" required />
                    <button type="submit" class="btn btn-sm btn-light" style="padding: 2px 8px;">Lọc</button>
                </form>
            </div>
            <h3 class="db-stat-card__value" style="margin-top: 10px;">@Model.TotalRevenue.ToString("N0")₫</h3>
            <span class="db-stat-card__sub">Đơn hàng hoàn thành</span>
        </div>
        <div class="db-stat-card__glow"></div>
    </div>

    <div class="db-stat-card db-stat--orders">
        <div class="db-stat-card__icon">
            <i class="bi bi-receipt-cutoff"></i>
        </div>
        <div class="db-stat-card__body">
            <span class="db-stat-card__label">Đơn hàng</span>
            <h3 class="db-stat-card__value">@Model.TotalOrders</h3>
            <span class="db-stat-card__sub">@Model.PendingOrders chờ duyệt</span>
        </div>
        <div class="db-stat-card__glow"></div>
    </div>

    <div class="db-stat-card db-stat--products">
        <div class="db-stat-card__icon">
            <i class="bi bi-box-seam-fill"></i>
        </div>
        <div class="db-stat-card__body">
            <span class="db-stat-card__label">Sản phẩm</span>
            <h3 class="db-stat-card__value">@Model.TotalProducts</h3>
            <span class="db-stat-card__sub">Trong hệ thống</span>
        </div>
        <div class="db-stat-card__glow"></div>
    </div>

    <div class="db-stat-card db-stat--customers">
        <div class="db-stat-card__icon">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="db-stat-card__body">
            <span class="db-stat-card__label">Khách hàng</span>
            <h3 class="db-stat-card__value">@Model.TotalCustomers</h3>
            <span class="db-stat-card__sub">Đã đăng ký</span>
        </div>
        <div class="db-stat-card__glow"></div>
    </div>
</section>

@* ===== ROW 2: BIỂU ĐỒ DOANH THU + TOP SẢN PHẨM ===== *@
<section class="db-grid-2col">
    @* --- Biểu đồ doanh thu --- *@
    <div class="db-panel">
        <div class="db-panel__header">
            <div>
                <h2 class="db-panel__title"><i class="bi bi-graph-up-arrow"></i> @Model.ChartTitle</h2>
                <p class="db-panel__subtitle">@Model.ChartSubtitle</p>
            </div>
        </div>
        <div class="db-panel__body">
            <div class="db-chart-wrap">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    @* --- Top 5 sản phẩm bán chạy --- *@
    <div class="db-panel">
        <div class="db-panel__header">
            <div>
                <h2 class="db-panel__title"><i class="bi bi-trophy-fill"></i> Top sản phẩm bán chạy</h2>
                <p class="db-panel__subtitle">Xếp hạng theo số lượng đã bán</p>
            </div>
        </div>
        <div class="db-panel__body db-panel__body--flush">
            @if (Model.TopProducts.Any())
            {
                <div class="db-top-products">
                    @{ var rank = 0; var maxQty = Model.TopProducts.Max(p => p.TotalQuantitySold); }
                    @foreach (var product in Model.TopProducts)
                    {
                        rank++;
                        var percent = maxQty > 0 ? (int)Math.Round((double)product.TotalQuantitySold / maxQty * 100) : 0;
                        var rankClass = rank <= 3 ? $"db-rank--{rank}" : "db-rank--other";
                        var imgSrc = string.IsNullOrWhiteSpace(product.ImageUrl) ? "" : product.ImageUrl;

                        <div class="db-product-row">
                            <span class="db-product-rank @rankClass">@rank</span>
                            @if (!string.IsNullOrWhiteSpace(imgSrc))
                            {
                                <img src="@imgSrc" alt="@product.ProductName" class="db-product-thumb" />
                            }
                            else
                            {
                                <div class="db-product-thumb db-product-thumb--placeholder">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                            <div class="db-product-info">
                                <span class="db-product-name">@product.ProductName</span>
                                <div class="db-product-bar-wrap">
                                    <div class="db-product-bar" style="width: @(percent)%"></div>
                                </div>
                            </div>
                            <div class="db-product-stats">
                                <span class="db-product-qty">@product.TotalQuantitySold đã bán</span>
                                <span class="db-product-rev">@product.TotalRevenue.ToString("N0")₫</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="db-empty-mini">
                    <i class="bi bi-emoji-neutral"></i>
                    <span>Chưa có dữ liệu bán hàng</span>
                </div>
            }
        </div>
    </div>
</section>

@* ===== ROW 3: ĐƠN HÀNG MỚI NHẤT + TRẠNG THÁI ĐƠN HÀNG ===== *@
<section class="db-grid-2col">
    @* --- Đơn hàng mới nhất --- *@
    <div class="db-panel">
        <div class="db-panel__header">
            <div>
                <h2 class="db-panel__title"><i class="bi bi-clock-history"></i> Đơn hàng mới nhất</h2>
                <p class="db-panel__subtitle">5 đơn hàng gần đây nhất trong hệ thống</p>
            </div>
            <a asp-controller="Order" asp-action="Index" class="db-panel__link">
                Xem tất cả <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="db-panel__body db-panel__body--flush">
            @if (Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table db-table" id="recent-orders-table">
                        <thead>
                            <tr>
                                <th>Mã ĐH</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                var statusText = order.Status switch
                                {
                                    0 => "Chờ duyệt",
                                    1 => "Đang giao",
                                    2 => "Hoàn thành",
                                    3 => "Đã hủy",
                                    _ => "Không rõ"
                                };
                                var statusClass = order.Status switch
                                {
                                    0 => "db-badge--pending",
                                    1 => "db-badge--shipping",
                                    2 => "db-badge--completed",
                                    3 => "db-badge--cancelled",
                                    _ => "db-badge--pending"
                                };

                                <tr>
                                    <td>
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="db-order-id">
                                            #@order.OrderId
                                        </a>
                                    </td>
                                    <td>
                                        <div class="db-customer-cell">
                                            <span class="db-customer-name">@order.CustomerName</span>
                                            @if (!string.IsNullOrWhiteSpace(order.CustomerEmail))
                                            {
                                                <span class="db-customer-email">@order.CustomerEmail</span>
                                            }
                                        </div>
                                    </td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td class="db-amount">@order.TotalAmount.ToString("N0")₫</td>
                                    <td><span class="db-badge @statusClass">@statusText</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="db-empty-mini">
                    <i class="bi bi-inbox"></i>
                    <span>Chưa có đơn hàng nào</span>
                </div>
            }
        </div>
    </div>

    @* --- Tổng quan trạng thái đơn hàng + Thống kê nhanh --- *@
    <div class="db-panel">
        <div class="db-panel__header">
            <div>
                <h2 class="db-panel__title"><i class="bi bi-pie-chart-fill"></i> Phân bố đơn hàng</h2>
                <p class="db-panel__subtitle">Theo trạng thái xử lý</p>
            </div>
        </div>
        <div class="db-panel__body">
            <div class="db-chart-wrap db-chart-wrap--doughnut">
                <canvas id="orderStatusChart"></canvas>
            </div>

            <div class="db-status-legend">
                <div class="db-status-item">
                    <span class="db-status-dot db-dot--pending"></span>
                    <span class="db-status-label">Chờ duyệt</span>
                    <strong class="db-status-count">@Model.PendingOrders</strong>
                </div>
                <div class="db-status-item">
                    <span class="db-status-dot db-dot--shipping"></span>
                    <span class="db-status-label">Đang giao</span>
                    <strong class="db-status-count">@Model.ShippingOrders</strong>
                </div>
                <div class="db-status-item">
                    <span class="db-status-dot db-dot--completed"></span>
                    <span class="db-status-label">Hoàn thành</span>
                    <strong class="db-status-count">@Model.CompletedOrders</strong>
                </div>
                <div class="db-status-item">
                    <span class="db-status-dot db-dot--cancelled"></span>
                    <span class="db-status-label">Đã hủy</span>
                    <strong class="db-status-count">@Model.CancelledOrders</strong>
                </div>
            </div>

            @* --- Quick links bổ sung --- *@
            <div class="db-quicklinks">
                <a class="db-quicklink" asp-controller="Post" asp-action="Index">
                    <i class="bi bi-file-earmark-text-fill"></i>
                    <span>@Model.TotalPosts Bài viết</span>
                </a>
                <a class="db-quicklink" asp-controller="Category" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>@Model.TotalCategories Danh mục</span>
                </a>
                <a class="db-quicklink" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam-fill"></i>
                    <span>@Model.TotalProducts Sản phẩm</span>
                </a>
                <a class="db-quicklink" asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>@Model.TotalCustomers Khách hàng</span>
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        // === XỬ LÝ BỘ LỌC DOANH THU ===
        function toggleCustomDates(value) {
            var customRange = document.getElementById('customDateRange');
            if (value === 'custom') {
                customRange.style.display = 'block';
            } else {
                customRange.style.display = 'none';
            }
        }

        // === BIỂU ĐỒ DOANH THU ĐỘNG ===
        (function () {
            var ctx = document.getElementById('revenueChart').getContext('2d');
            var labels = [@Html.Raw(string.Join(",", Model.DailyRevenues.Select(d => $"'{d.Date}'")))];
            var data = [@Html.Raw(string.Join(",", Model.DailyRevenues.Select(d => d.Revenue.ToString("F0"))))];

            var gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(59, 130, 246, 0.35)');
            gradient.addColorStop(1, 'rgba(59, 130, 246, 0.02)');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (₫)',
                        data: data,
                        backgroundColor: gradient,
                        borderColor: '#3b82f6',
                        borderWidth: 2,
                        borderRadius: 8,
                        borderSkipped: false,
                        hoverBackgroundColor: 'rgba(59, 130, 246, 0.55)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            titleFont: { size: 13, weight: '600' },
                            bodyFont: { size: 12 },
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: function (context) {
                                    return new Intl.NumberFormat('vi-VN').format(context.parsed.y) + '₫';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9', drawBorder: false },
                            ticks: {
                                font: { size: 11 },
                                color: '#94a3b8',
                                callback: function (value) {
                                    if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
                                    if (value >= 1000) return (value / 1000).toFixed(0) + 'K';
                                    return value;
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 12, weight: '500' }, color: '#64748b' }
                        }
                    }
                }
            });
        })();

        // === BIỂU ĐỒ PHÂN BỐ TRẠNG THÁI ĐƠN HÀNG ===
        (function () {
            var ctx = document.getElementById('orderStatusChart').getContext('2d');
            var statusData = [@Model.PendingOrders, @Model.ShippingOrders, @Model.CompletedOrders, @Model.CancelledOrders];
            var hasData = statusData.some(function (v) { return v > 0; });

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Chờ duyệt', 'Đang giao', 'Hoàn thành', 'Đã hủy'],
                    datasets: [{
                        data: hasData ? statusData : [1],
                        backgroundColor: hasData
                            ? ['#f59e0b', '#3b82f6', '#10b981', '#ef4444']
                            : ['#e2e8f0'],
                        borderColor: '#ffffff',
                        borderWidth: 3,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            enabled: hasData,
                            backgroundColor: '#1e293b',
                            titleFont: { size: 13, weight: '600' },
                            bodyFont: { size: 12 },
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: function (context) {
                                    var total = context.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                    var pct = total > 0 ? Math.round(context.parsed / total * 100) : 0;
                                    return context.label + ': ' + context.parsed + ' (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });
        })();
    </script>
}
