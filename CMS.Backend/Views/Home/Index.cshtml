Mô tả: Trang bảng điều khiển quản trị của hệ thống CMS.

Chú thích chi tiết:
- View này là dashboard chính của Admin Panel.
- Các thẻ chức năng giúp đi nhanh đến quản lý Danh mục, Bài viết và Thành viên.
- Model vẫn nhận danh sách bài viết mới nhất từ HomeController để hiển thị nhanh dữ liệu gần đây.
*@

@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Bảng điều khiển";
}

<section class="admin-stat-grid mb-4" aria-label="Lối tắt chức năng quản trị">
    <a class="admin-stat-card admin-gradient-blue" asp-controller="Category" asp-action="Index" id="dashboard-category-card">
        <i class="bi bi-grid-1x2-fill"></i>
        <h2>Danh mục</h2>
        <p>Quản lý nhóm nội dung, thêm mới, chỉnh sửa và xóa danh mục bài viết.</p>
    </a>

    <a class="admin-stat-card admin-gradient-purple" asp-controller="Post" asp-action="Index" id="dashboard-post-card">
        <i class="bi bi-file-earmark-richtext-fill"></i>
        <h2>Bài viết</h2>
        <p>Tạo bài viết mới, cập nhật nội dung, ảnh đại diện và chuyên mục hiển thị.</p>
    </a>

    <a class="admin-stat-card admin-gradient-green" asp-controller="User" asp-action="Index" id="dashboard-user-card">
        <i class="bi bi-people-fill"></i>
        <h2>Thành viên</h2>
        <p>Quản lý tài khoản Admin, Editor và chuẩn bị dữ liệu đăng nhập cho Buổi 5.</p>
    </a>
</section>

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Nội dung mới nhất</p>
            <h2 class="h4 fw-bold mb-0">3 bài viết gần đây</h2>
        </div>
        <a asp-controller="Post" asp-action="Create" class="btn btn-primary" id="dashboard-create-post">
            <i class="bi bi-plus-circle"></i> Thêm bài viết
        </a>
    </div>

    <div class="admin-card__body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Danh mục</th>
                            <th>Ngày đăng</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Title</td>
                                <td>
                                    <span class="badge text-bg-info">@(item.Category?.Name ?? "Chưa có danh mục")</span>
                                </td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                        Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                Hiện chưa có bài viết nào. Hãy bắt đầu bằng cách thêm bài viết mới.
            </div>
        }
    </div>
</section>
