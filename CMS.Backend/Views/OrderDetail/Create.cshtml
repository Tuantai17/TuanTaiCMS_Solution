@model CMS.Data.Entities.OrderDetail

@{
    ViewData["Title"] = "Thêm chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Create Order Detail</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-plus-circle"></i> Thêm chi tiết đơn hàng</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form id="order-detail-create-form" asp-action="Create" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="OrderId" class="form-label fw-bold">Đơn hàng: <span class="text-danger">*</span></label>
                        <select asp-for="OrderId" class="form-select" asp-items="ViewBag.OrderList" required>
                            <option value="">-- Chọn đơn hàng --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProductId" class="form-label fw-bold">Sản phẩm: <span class="text-danger">*</span></label>
                        <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductList" required>
                            <option value="">-- Chọn sản phẩm --</option>
                        </select>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Quantity" class="form-label fw-bold">Số lượng:</label>
                                <input asp-for="Quantity" class="form-control" type="number" min="1" value="1" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UnitPrice" class="form-label fw-bold">Đơn giá (₫):</label>
                                <input asp-for="UnitPrice" class="form-control" type="number" min="0" step="1000" required />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success" id="order-detail-save-button"><i class="bi bi-check-circle"></i> Lưu chi tiết</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
  document.getElementById('order-detail-create-form').addEventListener('submit', function (e) {
    if (!confirm('Bạn có chắc muốn thêm chi tiết đơn hàng này không?')) e.preventDefault();
  });
</script>
}
