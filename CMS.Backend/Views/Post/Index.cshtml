Mô tả: Trang danh sách bài viết trong khu vực quản trị.

Chú thích chi tiết:
- View này hiển thị danh sách bài viết dạng bảng quản trị.
- Model là danh sách Post, mỗi phần tử được render bằng vòng lặp foreach.
- Các nút Xem, Sửa và Xóa truyền Id qua route để controller xử lý đúng bản ghi.
*@

@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Quản lý bài viết";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Post Management</p>
            <h2 class="h4 fw-bold mb-0">Danh sách bài viết</h2>
        </div>
        <a asp-action="Create" class="btn btn-success" id="post-create-button">
            <i class="bi bi-file-earmark-plus"></i> Thêm bài viết mới
        </a>
    </div>

    <div class="admin-card__body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tiêu đề</th>
                        <th>Danh mục</th>
                        <th>Ngày đăng</th>
                        <th class="text-end" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                                     class="post-thumb"
                                     alt="Ảnh bài viết @item.Title" />
                            </td>
                            <td>
                                <strong>@item.Title</strong>
                                <div class="text-muted small text-truncate" style="max-width: 360px;">@item.Content</div>
                            </td>
                            <td>
                                <span class="post-category-badge">@(item.Category?.Name ?? "Chưa có danh mục")</span>
                            </td>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Xem</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
