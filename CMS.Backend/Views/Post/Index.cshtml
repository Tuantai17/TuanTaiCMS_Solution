Mô tả: Định nghĩa thực thể danh mục bài viết, dùng để phân loại và quản lý các bài viết trong hệ thống.

Chú thích chi tiết:
- View này hiển thị danh sách bài viết dạng card.
- Model là danh sách Post, mỗi phần tử được render bằng vòng lặp foreach.
- Category?.Name giúp tránh lỗi khi bài viết chưa có danh mục được nạp kèm.
*@

@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                         class="card-img-top"
                         alt="Ảnh bài viết @item.Title"
                         style="height: 220px; object-fit: cover;" />
                    <div class="card-body">
                        <span class="badge bg-info text-dark">@(item.Category?.Name ?? "Chưa có danh mục")</span>
                        <h5 class="card-title text-primary">@item.Title</h5>
                        <p class="card-text text-truncate">@item.Content</p>
                        <p class="text-muted small">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</p>
                        <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
