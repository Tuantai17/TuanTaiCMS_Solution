@model CMS.Data.Entities.CategoryProduct

@{
    ViewData["Title"] = "Chỉnh sửa loại sản phẩm";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Edit Category Product</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-pencil-square"></i> Chỉnh sửa loại sản phẩm</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form id="category-product-edit-form" asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên loại sản phẩm: <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên loại sản phẩm..." required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả:</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả ngắn cho loại sản phẩm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning" id="category-product-update-button">
                            <i class="bi bi-check-circle"></i> Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
  document.getElementById('category-product-edit-form').addEventListener('submit', function (e) {
    if (!confirm('Bạn có chắc muốn cập nhật loại sản phẩm này không?')) {
      e.preventDefault();
    }
  });
</script>
}
