@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Cập nhật thành viên";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Edit User</p>
            <h2 class="h4 fw-bold mb-0">Cập nhật thông tin thành viên</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PasswordHash" />

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập:</label>
                    <input asp-for="Username" class="form-control" readonly />
                    <small class="text-muted">Tên đăng nhập không được phép sửa.</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Mật khẩu mới:</label>
                    <input type="password" name="NewPassword" class="form-control" placeholder="Để trống nếu không muốn đổi" />
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-bold">Họ và tên:</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="Role" class="form-label fw-bold">Vai trò:</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Admin">Admin</option>
                        <option value="Editor">Editor</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning" id="user-update-button">
                    <i class="bi bi-check-circle"></i> Cập nhật
                </button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</section>
