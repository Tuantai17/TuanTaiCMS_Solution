Mô tả: Trang danh sách thành viên/người dùng trong khu vực quản trị.

Chú thích chi tiết:
- View này hiển thị danh sách thành viên/người dùng trong hệ thống.
- Model là danh sách User được UserController truyền sang.
- Bảng hiển thị ID, tên đăng nhập, họ tên, quyền hạn và nhóm nút thao tác.
*@

@model List<CMS.Data.Entities.User>

@{
    ViewData["Title"] = "Quản lý thành viên";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <h2 class="h4 fw-bold mb-0 d-none">Danh sách thành viên</h2>
        </div>
        <a asp-action="Create" class="btn btn-success" id="user-create-button">
            <i class="bi bi-plus-circle"></i> Thêm thành viên mới
        </a>
    </div>

    <div class="admin-card__body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Họ Và Tên</th>
                        <th style="width: 180px;">Quyền Hạn</th>
                        <th style="width: 150px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td><strong>@user.Username</strong></td>
                            <td>@user.FullName</td>
                            <td>
                                @if (user.Role == "Admin" || user.Role == "Administrator")
                                {
                                    <span class="badge bg-danger">Administrator</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">Editor</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-warning btn-sm">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @user.Username không?')">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
