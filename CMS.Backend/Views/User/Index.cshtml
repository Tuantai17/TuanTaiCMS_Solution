@model List<CMS.Data.Entities.User>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fw-bold">QUẢN LÝ THÀNH VIÊN</h2>
    <a href="#" class="btn btn-success btn-sm">+ Thêm thành viên mới</a>
</div>

<table class="table table-bordered table-sm align-middle">
    <thead>
        <tr>
            <th style="width: 70px;">ID</th>
            <th>Tên đăng nhập</th>
            <th>Họ và tên</th>
            <th style="width: 180px;">Quyền hạn</th>
            <th style="width: 150px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td><strong>@item.Username</strong></td>
                <td>@item.FullName</td>
                <td>
                    <span class="badge bg-info text-dark">@item.Role</span>
                </td>
                <td>
                    <a href="#" class="btn btn-outline-warning btn-sm">Sửa</a>
                    <a href="#" class="btn btn-outline-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
