@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Thêm Admin / Staff";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Create Admin / Staff Account</p>
            <h2 class="h4 fw-bold mb-0">Thêm Admin / Staff</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập:</label>
                    <input asp-for="Username" class="form-control" placeholder="Ví dụ: admin" required />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PasswordHash" class="form-label fw-bold">Mật khẩu:</label>
                    <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Nhập mật khẩu" required />
                    <small class="text-muted">Theo tài liệu Buổi 4, mật khẩu đang lưu dạng chữ thô để dễ kiểm tra.</small>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-bold">Họ và tên:</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="Role" class="form-label fw-bold">Vai trò:</label>
                    <select asp-for="Role" class="form-select" required>
                        <option value="Admin">Admin</option>
                        <option value="Staff">Staff</option>
                    </select>
                    <small class="text-muted">Customer được quản lý riêng tại mục Quản lý Khách hàng.</small>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success" id="user-save-button">
                    <i class="bi bi-check-circle"></i> Lưu thành viên
                </button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
