@model CMS.Backend.Models.AdminProductReviewIndexViewModel
@using CMS.Data.Enums
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="db-stat-row mb-4">
    <div class="db-stat-card db-stat--orders">
        <div class="db-stat-card__icon"><i class="bi bi-chat-left-text"></i></div>
        <div class="db-stat-card__body">
            <span class="db-stat-card__label">Tong danh gia</span>
            <p class="db-stat-card__value">@Model.Stats.TotalReviews</p>
        </div>
        <div class="db-stat-card__glow"></div>
    </div>
    <div class="db-stat-card" style="border-left:4px solid #f59e0b;">
        <div class="db-stat-card__icon" style="background:#fff7ed;color:#f59e0b;"><i class="bi bi-hourglass-split"></i></div>
        <div class="db-stat-card__body">
            <span class="db-stat-card__label">Cho duyet</span>
            <p class="db-stat-card__value">@Model.Stats.PendingReviews</p>
        </div>
        <div class="db-stat-card__glow" style="background:#f59e0b;"></div>
    </div>
    <div class="db-stat-card db-stat--revenue">
        <div class="db-stat-card__icon"><i class="bi bi-check-circle"></i></div>
        <div class="db-stat-card__body">
            <span class="db-stat-card__label">Da cong khai</span>
            <p class="db-stat-card__value">@Model.Stats.PublishedReviews</p>
        </div>
        <div class="db-stat-card__glow"></div>
    </div>
    <div class="db-stat-card" style="border-left:4px solid #8b5cf6;">
        <div class="db-stat-card__icon" style="background:#f5f3ff;color:#8b5cf6;"><i class="bi bi-reply"></i></div>
        <div class="db-stat-card__body">
            <span class="db-stat-card__label">Chua phan hoi</span>
            <p class="db-stat-card__value">@Model.Stats.UnrepliedReviews</p>
        </div>
        <div class="db-stat-card__glow" style="background:#8b5cf6;"></div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Tu khoa</label>
                <input class="form-control" name="keyword" value="@Model.Filter.Keyword" placeholder="Khach hang / san pham / noi dung" />
            </div>
            <div class="col-md-2">
                <label class="form-label">So sao</label>
                <select class="form-select" name="rating">
                    <option value="">Tat ca</option>
                    @for (var star = 5; star >= 1; star--)
                    {
                        <option value="@star" selected="@(Model.Filter.Rating == star)">@star sao</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Trang thai</label>
                <select class="form-select" name="status">
                    <option value="">Tat ca</option>
                    @foreach (var reviewStatus in Enum.GetValues<ReviewStatus>())
                    {
                        <option value="@reviewStatus" selected="@(Model.Filter.Status == reviewStatus)">@reviewStatus</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Phan hoi</label>
                <select class="form-select" name="hasReply">
                    <option value="">Tat ca</option>
                    <option value="true" selected="@(Model.Filter.HasReply == true)">Da phan hoi</option>
                    <option value="false" selected="@(Model.Filter.HasReply == false)">Chua phan hoi</option>
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">Tu ngay</label>
                <input class="form-control" type="date" name="fromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Den ngay</label>
                <input class="form-control" type="date" name="toDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Trang</label>
                <select class="form-select" name="pageSize">
                    @foreach (var size in new[] { 10, 20, 50 })
                    {
                        <option value="@size" selected="@(Model.Filter.PageSize == size)">@size</option>
                    }
                </select>
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> Loc</button>
                <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i> Dat lai</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Khach hang</th>
                    <th>San pham</th>
                    <th>Don hang</th>
                    <th>Sao</th>
                    <th>Noi dung</th>
                    <th>Hinh</th>
                    <th>Trang thai</th>
                    <th>Phan hoi</th>
                    <th>Ngay tao</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Reviews.Items.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">Chua co danh gia san pham nao.</td>
                    </tr>
                }
                @foreach (var review in Model.Reviews.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@review.CustomerName</div>
                            <div class="text-muted small">@review.CustomerEmail</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@review.ProductName</div>
                        </td>
                        <td>#@review.OrderId</td>
                        <td>
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                            }
                        </td>
                        <td style="max-width:320px;">
                            <div class="fw-semibold">@review.Title</div>
                            <div class="text-muted small">@(review.Content.Length > 120 ? review.Content[..120] + "..." : review.Content)</div>
                        </td>
                        <td>@review.ImageCount</td>
                        <td>
                            <span class="badge @(review.Status == ReviewStatus.Published ? "bg-success" : review.Status == ReviewStatus.Pending ? "bg-warning text-dark" : review.Status == ReviewStatus.Hidden ? "bg-secondary" : "bg-danger")">
                                @review.Status
                            </span>
                        </td>
                        <td>
                            <span class="badge @(review.HasReply ? "bg-success" : "bg-light text-dark border")">
                                @(review.HasReply ? "Da phan hoi" : "Chua phan hoi")
                            </span>
                        </td>
                        <td>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@review.Id">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Reviews.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (var i = 1; i <= Model.Reviews.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Reviews.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-pageSize="@Model.Filter.PageSize"
                       asp-route-keyword="@Model.Filter.Keyword"
                       asp-route-rating="@Model.Filter.Rating"
                       asp-route-status="@Model.Filter.Status"
                       asp-route-hasReply="@Model.Filter.HasReply"
                       asp-route-fromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")">@i</a>
                </li>
            }
        </ul>
    </nav>
}
