@model CMS.Data.Entities.Customer

@{
    ViewData["Title"] = "Chỉnh sửa khách hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Edit Customer</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-pencil-square"></i> Chỉnh sửa khách hàng</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form id="customer-edit-form" asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">Họ và tên: <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" required />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email: <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" type="email" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label fw-bold">Điện thoại:</label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-bold">Địa chỉ:</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">Mật khẩu: <span class="text-danger">*</span></label>
                        <input asp-for="Password" class="form-control" type="password" required />
                        <small class="text-muted">Nhập mật khẩu mới hoặc giữ nguyên mật khẩu cũ.</small>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning" id="customer-update-button">
                            <i class="bi bi-check-circle"></i> Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
  document.getElementById('customer-edit-form').addEventListener('submit', function (e) {
    if (!confirm('Bạn có chắc muốn cập nhật thông tin khách hàng này không?')) {
      e.preventDefault();
    }
  });
</script>
}
