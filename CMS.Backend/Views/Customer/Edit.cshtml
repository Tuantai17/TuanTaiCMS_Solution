@model CMS.Data.Entities.Customer

@{
    ViewData["Title"] = "Chỉnh sửa khách hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Edit Customer</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-pencil-square"></i> Chỉnh sửa khách hàng</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form id="customer-edit-form" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">Họ và tên: <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" required />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email: <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" type="email" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label fw-bold">Điện thoại:</label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DateOfBirth" class="form-label fw-bold">Ngày sinh:</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Gender" class="form-label fw-bold">Giới tính:</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-bold">Địa chỉ:</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ảnh đại diện:</label>
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.AvatarUrl" class="rounded-circle border" style="width: 80px; height: 80px; object-fit: cover;" alt="Avatar" />
                            </div>
                        }
                        <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Để trống nếu không muốn thay đổi ảnh đại diện hiện tại.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới:</label>
                        <input type="password" name="NewPassword" class="form-control" placeholder="Để trống nếu không muốn đổi mật khẩu" />
                        <small class="text-muted">Chỉ nhập khi muốn đổi mật khẩu. Mật khẩu sẽ được mã hóa BCrypt trước khi lưu.</small>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning" id="customer-update-button">
                            <i class="bi bi-check-circle"></i> Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
  document.getElementById('customer-edit-form').addEventListener('submit', function (e) {
    if (!confirm('Bạn có chắc muốn cập nhật thông tin khách hàng này không?')) {
      e.preventDefault();
    }
  });
</script>
}
