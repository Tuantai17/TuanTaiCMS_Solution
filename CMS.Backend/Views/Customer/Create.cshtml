@model CMS.Data.Entities.Customer

@{
    ViewData["Title"] = "Thêm khách hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="admin-card">
    <div class="admin-card__header">
        <div>
            <p class="admin-eyebrow mb-1">Create Customer</p>
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-person-plus"></i> Thêm khách hàng mới</h2>
        </div>
    </div>

    <div class="admin-card__body">
        <form id="customer-create-form" asp-action="Create" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">Họ và tên: <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A..." required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email: <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="email@example.com" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label fw-bold">Điện thoại:</label>
                                <input asp-for="Phone" class="form-control" placeholder="0912 345 678" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-bold">Địa chỉ:</label>
                        <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, quận, thành phố..." />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">Mật khẩu: <span class="text-danger">*</span></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Nhập mật khẩu..." required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success" id="customer-save-button">
                            <i class="bi bi-check-circle"></i> Lưu khách hàng
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
  document.getElementById('customer-create-form').addEventListener('submit', function (e) {
    if (!confirm('Bạn có chắc muốn thêm khách hàng này không?')) {
      e.preventDefault();
    }
  });
</script>
}
