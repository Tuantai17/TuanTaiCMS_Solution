@*
Sinh Viên: Nguyễn Tuấn Tài
Mã Sinh Viên: 2123110166
Lớp: CCQ2311E
Ngày Tạo: 15/5/2026
Mô tả: Layout quản trị dùng chung cho Admin Panel của hệ thống CMS.

Chú thích chi tiết:
- Sidebar cung cấp điều hướng nhanh đến Dashboard, Danh mục, Bài viết và Thành viên.
- @RenderBody() là vị trí nội dung của từng trang quản trị được hiển thị.
- @RenderSection("Scripts") cho phép từng View nạp thêm JavaScript riêng khi cần.
*@

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string IsActive(string controller, string? action = null)
    {
        var isControllerMatched = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var isActionMatched = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return isControllerMatched && isActionMatched ? "active" : string.Empty;
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Khu vực quản trị TuanTaiCMS dùng để quản lý danh mục, bài viết và thành viên." />
    <title>@ViewData["Title"] - TuanTaiCMS Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMS.Backend.styles.css" asp-append-version="true" />
    <style>
      .toast-success {
        position: fixed;
        top: 20px;
        right: 24px;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        background: #198754;
        color: #fff;
        border-radius: 6px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.18);
        font-size: 14px;
        font-weight: 500;
        animation: toast-in 0.3s ease, toast-out 0.4s ease 3.1s forwards;
      }
      .toast-danger {
        position: fixed;
        top: 20px;
        right: 24px;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        background: #dc3545;
        color: #fff;
        border-radius: 6px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.18);
        font-size: 14px;
        font-weight: 500;
        animation: toast-in 0.3s ease, toast-out 0.4s ease 3.1s forwards;
      }
      @@keyframes toast-in {
        from { opacity: 0; transform: translateY(-16px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @@keyframes toast-out {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-16px); }
      }
    </style>
</head>
<body class="admin-shell">

@if (TempData["SuccessMessage"] != null)
{
    <div class="toast-success" id="toast-success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
    <script>
      setTimeout(function () {
        var t = document.getElementById('toast-success');
        if (t) t.remove();
      }, 3500);
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="toast-danger" id="toast-danger">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
    <script>
      setTimeout(function () {
        var t = document.getElementById('toast-danger');
        if (t) t.remove();
      }, 3500);
    </script>
}
    <aside class="admin-sidebar">
        <a class="admin-brand" asp-controller="Home" asp-action="Index" aria-label="TuanTaiCMS Admin Dashboard">
            <strong>TuanTaiCMS Admin</strong>
        </a>

        <nav class="admin-nav" aria-label="Menu quan tri chinh">
            <!-- Tong quan -->
            <span class="admin-nav__group-label" style="display:block;padding:10px 16px 4px;font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.4);font-weight:600;">Tổng quan</span>
            <a id="nav-dashboard" class="admin-nav__link @IsActive("Home", "Index")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-speedometer2"></i>
                <span>Bảng điều khiển</span>
            </a>

            <!-- Quan ly noi dung -->
            <span class="admin-nav__group-label" style="display:block;padding:18px 16px 4px;font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.4);font-weight:600;">Quản lý nội dung</span>
            <a id="nav-category" class="admin-nav__link @IsActive("Category")" asp-controller="Category" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Danh mục bài viết</span>
            </a>
            <a id="nav-post" class="admin-nav__link @IsActive("Post")" asp-controller="Post" asp-action="Index">
                <i class="bi bi-file-earmark-text-fill"></i>
                <span>Bài viết</span>
            </a>
            <a id="nav-menu" class="admin-nav__link @IsActive("Menu")" asp-controller="Menu" asp-action="Index">
                <i class="bi bi-compass-fill"></i>
                <span>Menu</span>
            </a>
            <a id="nav-banner" class="admin-nav__link @IsActive("Banner")" asp-controller="Banner" asp-action="Index">
                <i class="bi bi-image-fill"></i>
                <span>Banner</span>
            </a>

            <!-- Quan ly san pham -->
            <span class="admin-nav__group-label" style="display:block;padding:18px 16px 4px;font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.4);font-weight:600;">Quản lý sản phẩm</span>
            <a id="nav-category-product" class="admin-nav__link @IsActive("CategoryProduct")" asp-controller="CategoryProduct" asp-action="Index">
                <i class="bi bi-tags-fill"></i>
                <span>Danh mục sản phẩm</span>
            </a>
            <a id="nav-product" class="admin-nav__link @IsActive("Product")" asp-controller="Product" asp-action="Index">
                <i class="bi bi-box-seam-fill"></i>
                <span>Sản phẩm</span>
            </a>
            <a id="nav-inventory" class="admin-nav__link @IsActive("Inventory")" asp-controller="Inventory" asp-action="Index">
                <i class="bi bi-box2-fill"></i>
                <span>Kho sản phẩm</span>
            </a>

            <!-- Quan ly tai khoan -->
            <span class="admin-nav__group-label" style="display:block;padding:18px 16px 4px;font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.4);font-weight:600;">Quản lý tài khoản</span>
            <a id="nav-user" class="admin-nav__link @IsActive("User")" asp-controller="User" asp-action="Index">
                <i class="bi bi-people-fill"></i>
                <span>Admin / Nhân viên</span>
            </a>
            <a id="nav-customer" class="admin-nav__link @IsActive("Customer")" asp-controller="Customer" asp-action="Index">
                <i class="bi bi-person-badge-fill"></i>
                <span>Khách hàng</span>
            </a>

            <!-- Quan ly ban hang -->
            <span class="admin-nav__group-label" style="display:block;padding:18px 16px 4px;font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.4);font-weight:600;">Quản lý bán hàng</span>
            <a id="nav-order" class="admin-nav__link @IsActive("Order")" asp-controller="Order" asp-action="Index">
                <i class="bi bi-cart-check-fill"></i>
                <span>Đơn hàng</span>
            </a>

            <!-- Thong bao va Email -->
            <span class="admin-nav__group-label" style="display:block;padding:18px 16px 4px;font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.4);font-weight:600;">Thông báo & Email</span>
            <a id="nav-notification" class="admin-nav__link @IsActive("Notification")" asp-controller="Notification" asp-action="Index">
                <i class="bi bi-bell-fill"></i>
                <span>Thông báo</span>
            </a>
            <a id="nav-emaillog" class="admin-nav__link @IsActive("EmailLog")" asp-controller="EmailLog" asp-action="Index">
                <i class="bi bi-envelope-paper-fill"></i>
                <span>Nhật ký gửi email</span>
            </a>
        </nav>

    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div>
                <p class="admin-eyebrow mb-1">Khu vực quản trị</p>
                <h1 class="admin-page-title">@(ViewData["Title"] ?? "Dashboard")</h1>
            </div>
            <div class="admin-topbar__meta">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="admin-user-chip" title="Thông tin tài khoản đang đăng nhập">
                        <i class="bi bi-person-circle"></i>
                        <span>
                            Chào, <strong>@User.FindFirst("FullName")?.Value</strong>
                            <small>(@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</small>
                        </span>
                    </div>
                    <a id="btn-logout" class="admin-logout-btn" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </a>
                }
                else
                {
                    <i class="bi bi-calendar-check"></i>
                    <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
                }
            </div>
        </header>

        <main class="admin-content" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
